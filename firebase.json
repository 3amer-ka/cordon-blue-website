{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "cordon-blue-deployment.zip",
      "*.md",
      "START-HERE.txt",
      "openclaw/**",
      "dataconnect/**",
      "*.zip",
      "*.pdf",
      "*.log",
      "Cordon_Blue_Portfolio.pdf",
      "portfolio-print.html",
      "firebase-debug.log",
      "memory.md",
      "flutter_app/**"
    ],
    "headers": [
      {
        "source": "assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}
